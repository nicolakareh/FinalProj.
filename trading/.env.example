# ============================================================
# tradesys configuration. Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ---- Alpaca keys (paper keys and live keys are different key pairs) ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# LIVE_MODE=false -> paper-api.alpaca.markets (fake money).
# LIVE_MODE=true  -> api.alpaca.markets (REAL money). Real orders are still
#                    blocked until you run `tradesys arm` and type GO LIVE.
# Flip this to false at any time to fall back to paper instantly.
LIVE_MODE=false

# ---- Hard risk limits (USD). Required when LIVE_MODE=true. ----
# The system never deploys more than this, whatever the account balance is.
TOTAL_CAPITAL_CAP=
# Max % of TOTAL_CAPITAL_CAP that a single trade can lose at its stop. Hard ceiling is 2.
MAX_RISK_PER_TRADE_PCT=2
# Realised + unrealised loss for the day at which trading halts until the next trading day.
DAILY_LOSS_LIMIT=
# Loss for the week (Mon-Sun) at which trading halts until you run `tradesys resume --weekly`.
WEEKLY_LOSS_LIMIT=
# Extra runaway guards.
MAX_OPEN_POSITIONS=10
MAX_ORDERS_PER_DAY=40
# Stop distance used when a signal gives no stop (percent below entry).
DEFAULT_STOP_PCT=3

# ---- Markets ----
STOCK_SYMBOLS=SPY,AAPL,MSFT
CRYPTO_SYMBOLS=BTC/USD,ETH/USD
# iex is free; sip needs a paid Alpaca data plan.
ALPACA_DATA_FEED=iex

# ---- Alerts: email (any SMTP; for Gmail use an App Password) ----
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# ---- Alerts: SMS via Twilio (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# ---- Discord bot (an official bot application, never a user token) ----
DISCORD_BOT_TOKEN=
# Comma separated channel IDs the bot should read trade calls from.
DISCORD_SIGNAL_CHANNEL_IDS=
# Your Discord user ID. Only this user may run !kill / !status etc.
DISCORD_OWNER_USER_ID=

# ---- News ----
# Optional newsapi.org key. Alpaca's news API and RSS feeds work without it.
NEWS_API_KEY=
# Extra RSS feeds, comma separated (defaults are built in).
NEWS_RSS_FEEDS=
NEWS_POLL_SECONDS=300
# A ticker is "unusual" when headlines in the last hour exceed mean + K*std of its hourly baseline.
NEWS_UNUSUAL_K=2.5
NEWS_UNUSUAL_MIN_COUNT=4

# ---- Paths ----
DB_PATH=data/tradesys.db
KILL_FILE=KILL
REPORTS_DIR=reports
BACKTESTS_DIR=backtests
DATA_DIR=data
